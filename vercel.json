{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "^wffperuchapter[.]page$" }],
      "destination": "https://www.wffperuchapter.page/:path",
      "permanent": true
    },
    { "source": "/comunicaciones.html", "destination": "/comunicaciones", "permanent": true },
    { "source": "/politicasygobernanza.html", "destination": "/politicasygobernanza", "permanent": true },
    { "source": "/relacionamiento.html", "destination": "/relacionamiento", "permanent": true },
    { "source": "/nosotros.html", "destination": "/nosotros", "permanent": true },
    { "source": "/educacionycultura.html", "destination": "/educacionycultura", "permanent": true },
    { "source": "/cienciaeinnovacion.html", "destination": "/cienciaeinnovacion", "permanent": true },
    { "source": "/empoderamiento-femenino.html", "destination": "/empoderamiento-femenino", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|bingbot|BingPreview|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Applebot|DuckDuckBot|Pinterestbot|SkypeUriPreview|Embedly).*"
        }
      ],
      "destination": "/api/meta?path=/:path*"
    },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
